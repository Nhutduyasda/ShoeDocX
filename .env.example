# ==========================================
# CẤU HÌNH MÔI TRƯỜNG DOCKER COMPOSE
# ==========================================

# Port truy cập giao diện Web (Frontend Nginx)
# Mặc định: 80 (hoặc đổi thành 3000, 8080 nếu máy chủ đã dùng port 80)
WEB_PORT=80

# Port truy cập trực tiếp Backend API (Tùy chọn, mặc định: 5270)
BACKEND_PORT=5270

# SQL Server cho backend khi chạy Docker. Không commit mật khẩu thật.
# Khi chạy backend trực tiếp trên Windows, appsettings.json dùng Windows Authentication.
SQLSERVER_CONNECTION_STRING=Server=host.docker.internal;Database=ShoeExportInvoice;User Id=sa;Password=replace_with_a_strong_password;Encrypt=False;TrustServerCertificate=True;Connect Timeout=15

# OpenAI API Key dùng cho tính năng Vision OCR trích xuất ảnh phiếu kho
# Định dạng: sk-proj-...
OPENAI_API_KEY=your_openai_api_key_here

# Khóa ký JWT bí mật, ngẫu nhiên, tối thiểu 32 bytes. Không commit giá trị thật.
JWT_KEY=replace_with_a_random_secret_of_at_least_32_bytes

# Chỉ bật một lần để tạo tài khoản quản trị đầu tiên, sau đó đặt lại false.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FULL_NAME=System Administrator
